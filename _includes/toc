<details id="entry-table-of-contents" class="toc-wrapper" open>
  <summary>
    <h2 class="no_toc">
      {{ site.data.text[site.locale].table_of_contents | default: 'Table of Contents' }}
      <svg class="toc-toggle-icon" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false">
        <path d="m4 6 4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </h2>
  </summary>
  <div class="toc-content">
    {% include toc.html html=content sanitize=true class="inline_toc" id="my_toc" h_min=2 h_max=3 %}
  </div>
</details>
